# Copy this file to .env and put your own key in it.
# .env is ignored by Git, so your real key is never committed.
#
# Get a Gemini API key at https://aistudio.google.com/
# (Get API key -> Create API key)

GEMINI_API_KEY=your_gemini_api_key_here

# The app also accepts GOOGLE_API_KEY as a fallback.
# GOOGLE_API_KEY=your_gemini_api_key_here
